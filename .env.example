# Copy to .env.local (for local dev) and add the same four values in Vercel →
# Project → Settings → Environment Variables. Leave them empty to run without sync.
# These are public identifiers, not secrets; Firestore rules protect your data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public address used in invite messages (optional; defaults to the Vercel URL)
NEXT_PUBLIC_SITE_URL=
