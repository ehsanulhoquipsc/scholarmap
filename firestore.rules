rules_version = '2';

// ScholarMap: every signed-in Google account gets its own private space at users/{uid}.
// Nobody can read or write another account's data, and there is nothing outside users/.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

// Optional extra lock (recommended): only allow YOUR Google account to use the database
// at all. Paste this version into the Firebase console instead of the one above and put
// your own email in place of YOUR_EMAIL. Keep the email out of this public repository.
//
//   allow read, write: if request.auth != null
//                      && request.auth.uid == userId
//                      && request.auth.token.email == "YOUR_EMAIL";
